# ==============================================================================
# Green Campus V1 - Backend Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="Green Campus V1"
API_V1_PREFIX="/api/v1"
DEBUG=False

# Security & JWT Token Auth
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Institutional Email Validation Domain
COLLEGE_EMAIL_DOMAIN="dypcoeakurdi.ac.in"

# Relational Database Connection
# Option A (Local SQLite - Default & recommended for local development): sqlite:///greencampus.db
# Option B (Local PostgreSQL): postgresql://postgres:postgres@localhost:5432/greencampus_db
# Option C (Supabase Direct): postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Option D (Supabase Connection Pooler / Render): postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="sqlite:///greencampus.db"

# ImageKit Cloud Object Storage
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
IMAGEKIT_FOLDER_ISSUES="/green-campus/issues"
IMAGEKIT_FOLDER_MARKETPLACE="/green-campus/marketplace"

# File Upload Guardrails
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB (5 * 1024 * 1024)

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
